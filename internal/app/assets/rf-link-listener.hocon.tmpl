# 仅增量添加此监听器；保留原FMO监听器、全局authentication及authorization。
# EMQX 5.8.9；不要把下面的认证器加入全局authentication数组。
listeners.tcp.rf_link {
  bind = "0.0.0.0:%d"
  enable_authn = true
  authentication = [{
    mechanism = password_based
    backend = http
    enable = true
    method = post
    url = %s
    headers { "content-type" = "application/json" }
    body { username = "${username}", password = "${password}" }
  }]
}
